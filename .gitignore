# Environments, tool caches and OS files (any folder)
.venv/
.bench-venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.hf/
.DS_Store
.claude/

# Local agent instructions, not part of the repository
AGENTS.md

# Local data, reproducible from scripts/fetch_samples.sh and the pipeline (any depth, so
# copies left at the old top-level paths stay ignored too); version with DVC if needed.
**/data/raw/
**/data/normalized/
**/data/bench/
**/data/samples/*.pdf
**/data/samples/*.html
**/data/samples/*.png
**/data/samples/*.truth.json
!**/data/samples/.gitkeep

**/data/index/

# Local-only: the generated technical report and its builder, never published (any depth,
# so they stay ignored at the old top-level paths and inside packages/docingest/)
**/docingest_report.pdf
**/docingest_overview.pdf
**/docs/report/
**/scripts/build_report.py

# Machine-specific settings of the model servers
serving/env.local

# Machine-specific settings of the shared-server script (deploy/research-api.sh)
deploy/env.local

# Local settings and databases of the research API (config.example.toml is the tracked example)
**/research-api.local.toml
*.sqlite3

# Web app (apps/web): installed packages, build output, test output
apps/web/node_modules/
apps/web/dist/
apps/web/coverage/
apps/web/playwright-report/
apps/web/test-results/
